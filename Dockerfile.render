FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends graphviz graphviz-dev gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/app

COPY Pipfile Pipfile.lock ./
RUN pip install pipenv \
    && pipenv install --system --deploy

COPY . .

EXPOSE 3000
CMD ["gunicorn", "--chdir", "src", "wsgi:application"]